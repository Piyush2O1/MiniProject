<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <style>
      body { font-family: Arial, sans-serif; background: #eef3f8; color: #152033; margin: 0; }
      .shell { max-width: 1400px; margin: 32px auto; padding: 0 20px 40px; }
      .topbar, .panel, .list, .card { background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(21,32,51,.08); }
      .topbar { padding: 20px 24px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; margin-bottom: 24px; }
      .panel { padding: 20px; margin-bottom: 24px; }
      .list-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: start; }
      .list { padding: 18px; display: grid; gap: 14px; }
      .card { padding: 16px; display: grid; gap: 10px; }
      h1, h2, h3, h4 { margin: 0; }
      p { margin: 0; }
      form { display: grid; gap: 10px; }
      input, textarea, select { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #cdd6e1; border-radius: 10px; font-size: 14px; }
      textarea { min-height: 82px; resize: vertical; }
      button, a.button { border: 0; border-radius: 10px; padding: 10px 14px; font-size: 14px; cursor: pointer; background: #1f6feb; color: #fff; text-decoration: none; display: inline-block; }
      .muted { background: #e8eef8; color: #152033; }
      .danger { background: #b42318; }
      .warning { background: #f59e0b; color: #152033; }
      .error { background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 10px; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .subtasks { display: grid; gap: 8px; }
      .subtask { display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #f8fafc; padding: 10px; border-radius: 10px; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 999px; background: #e8eef8; font-size: 12px; }
      .meta { color: #5b6472; font-size: 13px; }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="topbar">
        <div>
          <h1><%= board.title %></h1>
          <p class="meta">Manage lists, cards, members, and subtasks.</p>
        </div>
        <div class="actions">
          <a class="button muted" href="/boards">Back to dashboard</a>
          <form action="/auth/logout" method="post">
            <button class="muted" type="submit">Logout</button>
          </form>
        </div>
      </section>

      <section class="panel">
        <h2>Add list</h2>
        <% if (error) { %>
          <div class="error" style="margin-top: 12px;"><%= error %></div>
        <% } %>
        <form action="/lists/<%= board._id %>" method="post" style="margin-top: 14px;">
          <input type="text" name="title" placeholder="List title" required />
          <button type="submit">Create list</button>
        </form>
      </section>

      <section class="list-grid">
        <% lists.forEach((list) => { %>
          <article class="list">
            <div style="display:grid; gap:10px;">
              <div>
                <h3><%= list.title %></h3>
                <p class="meta"><%= list.cards.length %> card(s)</p>
              </div>
              <form action="/lists/<%= list._id %>/edit" method="post">
                <input type="text" name="title" value="<%= list.title %>" required />
                <div class="actions">
                  <button class="muted" type="submit">Rename list</button>
                </div>
              </form>
              <form action="/lists/<%= list._id %>/delete" method="post">
                <button class="danger" type="submit">Delete list</button>
              </form>
            </div>

            <section class="panel" style="margin:0; box-shadow:none; background:#f8fafc;">
              <h4>Add card</h4>
              <form action="/cards/<%= list._id %>" method="post">
                <input type="text" name="title" placeholder="Task title" required />
                <textarea name="description" placeholder="Description"></textarea>
                <input type="date" name="dueDate" />
                <select name="type">
                  <option value="personal">Personal</option>
                  <option value="group">Group</option>
                </select>
                <input type="text" name="groupName" placeholder="Group name for group tasks" />
                <input type="text" name="members" placeholder="Comma-separated members" />
                <textarea name="subtasksText" placeholder="One subtask per line for group tasks"></textarea>
                <button type="submit">Create card</button>
              </form>
            </section>

            <% list.cards.forEach((card) => { %>
              <article class="card">
                <div style="display:grid; gap:6px;">
                  <div class="actions" style="justify-content:space-between;">
                    <h4><%= card.title %></h4>
                    <span class="badge"><%= card.type %></span>
                  </div>
                  <% if (card.description) { %>
                    <p><%= card.description %></p>
                  <% } %>
                  <% if (card.groupName) { %>
                    <p class="meta">Group: <%= card.groupName %></p>
                  <% } %>
                  <% if (card.members && card.members.length) { %>
                    <p class="meta">Members: <%= card.members.join(', ') %></p>
                  <% } %>
                  <% if (card.dueDate) { %>
                    <p class="meta">Due: <%= new Date(card.dueDate).toLocaleDateString() %></p>
                  <% } %>
                </div>

                <form action="/cards/edit/<%= card._id %>" method="post">
                  <input type="text" name="title" value="<%= card.title %>" required />
                  <textarea name="description"><%= card.description || '' %></textarea>
                  <input type="date" name="dueDate" value="<%= formatDateInput(card.dueDate) %>" />
                  <select name="type">
                    <option value="personal" <%= card.type === 'personal' ? 'selected' : '' %>>Personal</option>
                    <option value="group" <%= card.type === 'group' ? 'selected' : '' %>>Group</option>
                  </select>
                  <input type="text" name="groupName" value="<%= card.groupName || '' %>" placeholder="Group name" />
                  <input type="text" name="members" value="<%= (card.members || []).join(', ') %>" placeholder="Comma-separated members" />
                  <button class="muted" type="submit">Save card</button>
                </form>

                <form action="/cards/move/<%= card._id %>" method="post">
                  <select name="listId" required>
                    <% lists.forEach((destination) => { %>
                      <option value="<%= destination._id %>" <%= String(destination._id) === String(list._id) ? 'selected' : '' %>><%= destination.title %></option>
                    <% }) %>
                  </select>
                  <button class="warning" type="submit">Move card</button>
                </form>

                <form action="/cards/delete/<%= card._id %>" method="post">
                  <button class="danger" type="submit">Delete card</button>
                </form>

                <% if (card.type === 'group') { %>
                  <section class="subtasks">
                    <h4>Subtasks</h4>
                    <% if (card.subtasks.length) { %>
                      <% card.subtasks.forEach((subtask) => { %>
                        <div class="subtask">
                          <span><%= subtask.isDone ? '[Done]' : '[Open]' %> <%= subtask.title %></span>
                          <div class="actions">
                            <form action="/cards/subtasks/<%= card._id %>/<%= subtask._id %>/toggle" method="post">
                              <button class="muted" type="submit">Toggle</button>
                            </form>
                            <form action="/cards/subtasks/<%= card._id %>/<%= subtask._id %>/delete" method="post">
                              <button class="danger" type="submit">Delete</button>
                            </form>
                          </div>
                        </div>
                      <% }) %>
                    <% } %>
                    <form action="/cards/subtasks/<%= card._id %>" method="post">
                      <input type="text" name="title" placeholder="New subtask title" required />
                      <button type="submit">Add subtask</button>
                    </form>
                  </section>
                <% } %>
              </article>
            <% }) %>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>
