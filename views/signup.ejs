      .container { max-width: 420px; margin: 60px auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 10px 30px rgba(21,32,51,.1); }
      h1 { margin-top: 0; }
      form { display: grid; gap: 14px; }
      label { display: grid; gap: 6px; font-weight: 600; }
      input { padding: 10px 12px; border: 1px solid #cdd6e1; border-radius: 10px; font-size: 14px; }
      button, .link-btn { border: 0; border-radius: 10px; padding: 12px 16px; font-size: 14px; cursor: pointer; background: #1f6feb; color: #fff; text-decoration: none; text-align: center; }
      .secondary { background: #e8eef8; color: #152033; }
      .error { background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 10px; }
      .actions { display: grid; gap: 10px; }
    </style>
