<%- include('partials/header', { pageTitle }) %>

<section class="auth-card">
  <h1>Login</h1>
  <p class="page-note">Sign in to view your boards and manage tasks.</p>

  <% if (error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <form action="/auth/login" method="POST" class="stack-form">
    <label>
      Email
      <input type="email" name="email" maxlength="<%= validationLimits.email.max %>" required />
    </label>

    <label>
      Password
      <input
        type="password"
        name="password"
        minlength="<%= validationLimits.password.min %>"
        maxlength="<%= validationLimits.password.max %>"
        required
      />
    </label>

    <button type="submit">Login</button>
  </form>

  <p class="page-note">
    New here?
    <a href="/auth/signup">Create an account</a>
  </p>
</section>

<%- include('partials/footer') %>
