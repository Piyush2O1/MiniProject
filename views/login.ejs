<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <style>
      body { font-family: Arial, sans-serif; background: #f4f7fb; color: #152033; margin: 0; }
      .container { max-width: 420px; margin: 60px auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 10px 30px rgba(21,32,51,.1); }
      h1 { margin-top: 0; }
      form { display: grid; gap: 14px; }
      label { display: grid; gap: 6px; font-weight: 600; }
      input { padding: 10px 12px; border: 1px solid #cdd6e1; border-radius: 10px; font-size: 14px; }
      button, .link-btn { border: 0; border-radius: 10px; padding: 12px 16px; font-size: 14px; cursor: pointer; background: #1f6feb; color: #fff; text-decoration: none; text-align: center; }
      .secondary { background: #e8eef8; color: #152033; }
      .error { background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 10px; }
      .actions { display: grid; gap: 10px; }
    </style>
  </head>
  <body>
    <main class="container">
      <h1>Login</h1>
      <p>Sign in to manage your boards and tasks.</p>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/auth/login" method="post">
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Password
          <input type="password" name="password" required />
        </label>
        <div class="actions">
          <button type="submit">Login</button>
          <a class="link-btn secondary" href="/auth/signup">Create account</a>
        </div>
      </form>
    </main>
  </body>
</html>
