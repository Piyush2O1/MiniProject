<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <style>
      body { font-family: Arial, sans-serif; background: #f4f7fb; color: #152033; margin: 0; }
      .container { max-width: 560px; margin: 80px auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 10px 30px rgba(21,32,51,.1); }
      a { color: #1f6feb; text-decoration: none; }
    </style>
  </head>
  <body>
    <main class="container">
      <h1><%= pageTitle %></h1>
      <p><%= message %></p>
      <p style="margin-top: 18px;"><a href="/">Go back home</a></p>
    </main>
  </body>
</html>
